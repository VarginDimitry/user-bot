# Docker Compose registry host (no scheme), e.g. registry.example.com:5000
REGISTRY_HOST=registry.example.com:5000

USER_BOT__API_ID=xxx
USER_BOT__API_HASH=xxx
# USER_BOT__APP_NAME=Telethon

LOGGER__BOT_TOKEN=xxx
LOGGER__ERROR_LOGGER_SEND_TO=1
# LOGGER__ENABLE_TELEGRAM=true

WHISPER__MODEL=large-v3-turbo
WHISPER__DEVICE=cpu
WHISPER__COMPUTE_TYPE=int8
WHISPER__CPU_THREADS=1
WHISPER__DOWNLOAD_ROOT=downloads/whisper
WHISPER__BLACK_LIST='[1, 2]'
WHISPER__WHITE_LIST='[1, 2]'

GEMINI__API_KEY=xxx

OPENAI__BASE_URL="http://localhost:3000/v1"
OPENAI__API_KEY=cursor
OPENAI__MODEL=cursor-grok-4.5-low

INSTAGRAM__BLACK_LIST='[1, 2]'
# INSTAGRAM__DOWNLOAD_BOT_ID=523131145
# INSTAGRAM__DOWNLOAD_BOT_TIMEOUT=120

# Docker Compose: use host `postgres` and port `5432`
POSTGRES__DNS="postgresql+asyncpg://usrbot:usrbot@postgres:5432/usrbot"
# Local (outside Docker): postgresql+asyncpg://usrbot:usrbot@localhost:5131/usrbot
# POSTGRES__ECHO=true
# POSTGRES__MAX_POOL_SIZE=5
